// ╔════════════════════════════════════════════════════════════════════╗
// ║  niri · "Neon Mono"  —  dark cyberpunk × minimal mono                ║
// ║  Behavior re-based on well-tuned community configs so tiling feels   ║
// ║  smooth, not jumpy:                                                  ║
// ║    · niri default config (niri-wm/niri)                             ║
// ║    · github.com/Rouzihiro/dotfiles                                  ║
// ║    · github.com/marcinjahn/dotfiles                                 ║
// ║                                                                      ║
// ║  After editing:  niri validate -c ~/.config/niri/config.kdl          ║
// ║  niri hot-reloads on save. If a line is flagged, comment it (//).    ║
// ╚════════════════════════════════════════════════════════════════════╝

// ── Input ─────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 400
        repeat-rate 45
    }

    touchpad {
        tap
        dwt                       // disable-while-typing
        natural-scroll
        accel-speed 0.2
        accel-profile "flat"
    }

    mouse {
        // Sensitivity lever: -1.0 (slowest) … 0.0 (raw) … 1.0 (fastest).
        // You said it was too fast, so we slow it a touch. Nudge to taste.
        accel-speed -0.4
        accel-profile "flat"
    }

    // NOTE: cursor-warp-to-focus and focus-follows-mouse are intentionally
    // OFF — they're a big part of what made it feel "weird/jumpy". Re-enable
    // if you decide you like them:
    // warp-mouse-to-focus mode="center-xy"
    // focus-follows-mouse max-scroll-amount="10%"
}

// ── Outputs (YOUR dual-monitor setup) ─────────────────────────────────
// ⚠ FIRST: run  `niri msg outputs`  and replace the connector names below
//   with your real ones (e.g. DP-1, DP-2, HDMI-A-1). Everything else is set
//   for your layout: 1080p@144 on the LEFT, 1440p@270 on the RIGHT.
//
// Modes are left commented so niri auto-picks each monitor's *preferred*
// mode (usually the max refresh = your 144 / 270). Only uncomment `mode`
// and paste the EXACT string from `niri msg outputs` if you need to force it.

output "DP-3" {                           // Acer VG270U — 1440p 270Hz (right, primary)
    mode "2560x1440@270.002"
    scale 1.0
    position x=1920 y=0
    variable-refresh-rate on-demand=true
    focus-at-startup
}

output "HDMI-A-1" {                       // ASUS VG2791R — 1080p 144Hz (left)
    mode "1920x1080@143.600"
    scale 1.0
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

// ── Layout ────────────────────────────────────────────────────────────
layout {
    gaps 12
    background-color "transparent"        // let the wallpaper (swww) show through

    // ★ The settings that make scroll-tiling feel sane:
    center-focused-column "on-overflow"   // only scroll when a column would go off-screen
    always-center-single-column           // a lone window sits centered, not stuck left
    default-column-display "normal"

    // Windows open at 2/3 width (felt much less cramped than 1/2).
    default-column-width { proportion 0.66667; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.9
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Signature cyan→violet gradient on the focused window.
    focus-ring {
        width 2
        active-gradient from="#5ef1ff" to="#c46fff" angle=45 relative-to="workspace-view"
        inactive-color "#222734"
    }

    border {
        off
        width 2
        active-gradient from="#5ef1ff" to="#c46fff" angle=45 relative-to="workspace-view"
        inactive-color "#222734"
    }

    shadow {
        on
        softness 28
        spread 4
        offset x=0 y=8
        color "#000000aa"
    }

    // Where a dragged window will drop.
    insert-hint {
        color "#5ef1ff55"
    }

    // Neon tabs for tabbed columns (Mod+W).
    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 6
        width 4
        position "left"
        corner-radius 8
        active-color "#5ef1ff"
        inactive-color "#4b5468"
    }

    struts { }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

hotkey-overlay { skip-at-startup; }

cursor {
    xcursor-size 24
    // install 'bibata-cursor-theme', then: xcursor-theme "Bibata-Modern-Ice"
}

// ── Environment ───────────────────────────────────────────────────────
environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    SDL_VIDEODRIVER "wayland"
    _JAVA_AWT_WM_NONREPARENTING "1"
    GDK_BACKEND "wayland,x11"
}

// ── Autostart ─────────────────────────────────────────────────────────
// Noctalia is the whole shell — bar, launcher, notifications, lock, idle,
// OSD, AND wallpaper. So we deliberately DON'T start waybar / swaync /
// hypridle / swayosd / swww here; Noctalia replaces every one of them.
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// For X11 apps (Steam, some games): install 'xwayland-satellite', then:
// spawn-at-startup "xwayland-satellite"

// ── Animations ────────────────────────────────────────────────────────
animations {
    // slowdown 1.0
    window-open  { duration-ms 200; curve "ease-out-expo"; }
    window-close { duration-ms 150; curve "ease-out-quad"; }
    window-movement          { spring damping-ratio=0.92 stiffness=700 epsilon=0.0001; }
    window-resize            { spring damping-ratio=1.0  stiffness=800 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=0.95 stiffness=700 epsilon=0.0001; }
    workspace-switch         { spring damping-ratio=1.0  stiffness=900 epsilon=0.0001; }
    overview-open-close      { spring damping-ratio=0.9  stiffness=700 epsilon=0.0001; }
    config-notification-open-close { spring damping-ratio=0.7 stiffness=900 epsilon=0.001; }
}

// ── Window rules ──────────────────────────────────────────────────────
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(pavucontrol|org\.pulseaudio\.pavucontrol|blueman-manager|nm-connection-editor|org\.gnome\.Calculator|file-roller)$"#
    open-floating true
}

window-rule {
    match title="^Picture-in-Picture$"
    match title="^Picture in picture$"
    open-floating true
}

// ── Keybinds ──────────────────────────────────────────────────────────
// Mod = Super. Full list any time with  Mod+Shift+/
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return        { spawn "kitty"; }
    Mod+D             { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+E             { spawn "nautilus"; }
    Mod+B             { spawn "firefox"; }
    Mod+Shift+Escape  { spawn "kitty" "-e" "btop"; }   // task manager — full live metrics
    Mod+Shift+N       { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Super+Alt+L       { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "lockScreen" "lock"; }
    Mod+X             { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    // Wallpaper picker (Noctalia). If it no-ops on your version, set walls in Settings.
    Mod+Shift+W       { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "wallpaper" "toggle"; }
    // Clipboard history (cliphist + fuzzel) — pick a past copy and re-copy it
    Mod+Shift+C       { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    // Alt-tab: jump straight back to the last window you were on (MRU), no mouse
    Mod+Tab           repeat=false { focus-window-previous; }

    // Window / column management
    Mod+Q             { close-window; }
    Mod+F             { maximize-column; }
    Mod+Shift+F       { fullscreen-window; }
    Mod+C             { center-column; }
    Mod+V             { toggle-window-floating; }
    Mod+Shift+V       { switch-focus-between-floating-and-tiling; }
    Mod+W             { toggle-column-tabbed-display; }
    Mod+R             { switch-preset-column-width; }
    Mod+Shift+R       { switch-preset-window-height; }

    // Focus — arrows or hjkl
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Move
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // Move windows/columns between monitors
    Mod+Shift+Left  { move-column-to-monitor-left; }
    Mod+Shift+Right { move-column-to-monitor-right; }

    // Build/break columns
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Sizing
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Workspaces & overview
    Mod+O         { toggle-overview; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // Screenshots
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Media & brightness — routed through Noctalia so you get its OSD popup.
    // (Still work on the lock screen.)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "increase"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "decrease"; }
    XF86AudioMute         allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteOutput"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteInput"; }
    XF86AudioPlay         allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "playPause"; }
    XF86AudioNext         allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "decrease"; }

    // Session
    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P     { power-off-monitors; }
}

