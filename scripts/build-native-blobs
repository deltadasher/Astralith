#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
upstream_url="https://github.com/caelestia-dots/shell.git"
upstream_revision="1d0e5a588c61f1d905eba5fe8446ec222d37f50c"
cache_base="${XDG_CACHE_HOME:-$HOME/.cache}/astralith"
source_dir="$cache_base/caelestia-shell-$upstream_revision"
build_dir="$project_root/build/caelestia-blobs"
qml_output_dir="$project_root/.runtime/qml"

for command_name in git cmake ninja c++; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'Missing native blob build dependency: %s\n' "$command_name" >&2
        exit 2
    fi
done

if [[ ! -f /usr/lib/cmake/Qt6ShaderTools/Qt6ShaderToolsConfig.cmake ]]; then
    printf 'Missing qt6-shadertools. On Arch Linux run:\n' >&2
    printf '  sudo pacman -S qt6-shadertools\n' >&2
    exit 2
fi

mkdir -p -- "$cache_base" "$build_dir" "$qml_output_dir"

if [[ ! -d "$source_dir/.git" ]]; then
    git clone --filter=blob:none --no-checkout "$upstream_url" "$source_dir"
    git -C "$source_dir" sparse-checkout init --cone
    # Cone-mode sparse checkouts retain repository-root files such as LICENSE.
    git -C "$source_dir" sparse-checkout set plugin/src/Caelestia/Blobs
fi

git -C "$source_dir" fetch --depth=1 origin "$upstream_revision"
git -C "$source_dir" checkout --detach --force "$upstream_revision"

actual_revision="$(git -C "$source_dir" rev-parse HEAD)"
if [[ "$actual_revision" != "$upstream_revision" ]]; then
    printf 'Caelestia revision mismatch: expected %s, got %s\n' \
        "$upstream_revision" "$actual_revision" >&2
    exit 1
fi

cmake -S "$project_root/vendor/caelestia-blobs" -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCAELESTIA_SOURCE_DIR="$source_dir" \
    -DASTRALITH_QML_OUTPUT_DIR="$qml_output_dir"
cmake --build "$build_dir"

if [[ ! -f "$qml_output_dir/Caelestia/Blobs/qmldir" ]]; then
    printf 'Native blob build completed without a QML module descriptor.\n' >&2
    exit 1
fi

printf 'Built Caelestia.Blobs %s for Astralith.\n' "$upstream_revision"
printf 'Restart Astralith to activate the native surface renderer.\n'
