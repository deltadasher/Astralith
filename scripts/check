#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
python_cache="${TMPDIR:-/tmp}/astralith-check-pycache"
failures=0
silent_qmllint=0
silent_qml_files=()
qml_import_args=(-I .)

if [[ -f "$project_root/.runtime/qml/Caelestia/Blobs/qmldir" ]]; then
    qml_import_args+=(-I "$project_root/.runtime/qml")
fi

cd -- "$project_root"

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'Missing required check tool: %s\n' "$1" >&2
        exit 2
    fi
}

require_command python3
require_command qmllint

PYTHONPYCACHEPREFIX="$python_cache" python3 -m compileall -q scripts
PYTHONPYCACHEPREFIX="$python_cache" python3 -m unittest discover -s tests -q
bash tests/test_cli.sh
bash -n scripts/astralithctl scripts/check scripts/dev scripts/doctor scripts/install-user \
    scripts/build-native-blobs \
    scripts/snipping-tool scripts/sync-compositor-configs scripts/uninstall-user \
    scripts/update-user scripts/wallpaper-apply tests/test_cli.sh
sh -n scripts/astralith-notify

if command -v niri >/dev/null 2>&1; then
    niri validate -c niri/config.kdl
else
    printf 'WARN niri is unavailable; config validation skipped.\n'
fi

while IFS= read -r -d '' qml_file; do
    if [[ "$qml_file" == "./modules/ephemeris/NativeBlobBackdrop.qml" ]] \
            && [[ ! -f .runtime/qml/Caelestia/Blobs/qmldir ]]; then
        continue
    fi
    lint_output=""
    lint_status=0
    lint_output="$(qmllint "${qml_import_args[@]}" "$qml_file" 2>&1)" || lint_status=$?
    if (( lint_status == 0 )); then
        continue
    fi
    if (( lint_status == 255 )) && [[ -z "$lint_output" ]]; then
        silent_qmllint=$((silent_qmllint + 1))
        silent_qml_files+=("$qml_file")
        continue
    fi
    printf 'QML FAIL %s (status %s)\n%s\n' "$qml_file" "$lint_status" "$lint_output" >&2
    failures=$((failures + 1))
done < <(find . -type f -name '*.qml' -print0)

if (( silent_qmllint > 0 )); then
    printf 'WARN qmllint exited silently on %s components; validate these with the live Quickshell parser:\n' "$silent_qmllint"
    printf '  %s\n' "${silent_qml_files[@]}"
fi

if (( failures > 0 )); then
    printf 'Astralith checks failed: %s QML component(s).\n' "$failures" >&2
    exit 1
fi

printf 'Astralith checks passed.\n'
