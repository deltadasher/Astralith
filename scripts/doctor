#!/usr/bin/env bash

set -uo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
missing_required=0
available_optional=0
missing_optional=0

status_line() {
    local state="$1"
    local name="$2"
    local description="$3"
    printf '  %-7s %-24s %s\n' "$state" "$name" "$description"
}

check_required() {
    local command_name="$1"
    local description="$2"
    if command -v "$command_name" >/dev/null 2>&1; then
        status_line "OK" "$command_name" "$description"
    else
        status_line "MISSING" "$command_name" "$description"
        missing_required=$((missing_required + 1))
    fi
}

check_optional() {
    local command_name="$1"
    local description="$2"
    if command -v "$command_name" >/dev/null 2>&1; then
        status_line "OK" "$command_name" "$description"
        available_optional=$((available_optional + 1))
    else
        status_line "OPTION" "$command_name" "$description"
        missing_optional=$((missing_optional + 1))
    fi
}

printf 'Astralith machine doctor\n'
printf 'Source: %s\n\n' "$project_root"

printf 'Core runtime\n'
check_required qs "Quickshell command surface"
check_required niri "Niri compositor and config validator"
check_required python3 "Astralith service adapters"
check_required wpctl "PipeWire volume telemetry"
check_required pactl "PipeWire/Pulse mixer inventory"

printf '\nDesktop integrations\n'
check_optional nmcli "Wi-Fi and Ethernet controls"
check_optional bluetoothctl "Bluetooth discovery and pairing"
check_optional wl-paste "Clipboard watcher"
check_optional wl-copy "Clipboard output and screenshot copy"
check_optional cliphist "Clipboard history"
check_optional grim "Wayland screenshot capture"
check_optional slurp "Interactive region selection"
check_optional satty "Screenshot annotation"
check_optional gpu-screen-recorder "60 FPS recording"
check_optional brightnessctl "Backlight control"
check_optional powerprofilesctl "Power profile controls"
check_optional awww "Animated image wallpapers"
check_optional mpvpaper "Video wallpapers"
check_optional matugen "Wallpaper-derived palettes"
check_optional ffmpeg "Video wallpaper palette sampling"
check_optional cava "Media spectrum"
check_optional easyeffects "Equalizer presets"
check_optional fc-match "Font resolution diagnostics"

printf '\nTypography\n'
if command -v fc-match >/dev/null 2>&1; then
    for family in "JetBrains Mono" "Iosevka Nerd Font"; do
        resolved="$(fc-match --format '%{family}\n' "$family" 2>/dev/null | head -n 1)"
        if [[ "$resolved" == *"$family"* ]]; then
            status_line "OK" "$family" "resolved by Fontconfig"
        else
            status_line "CHECK" "$family" "resolved as ${resolved:-unknown}"
        fi
    done
else
    status_line "OPTION" "Fontconfig" "install fc-match to diagnose fonts"
fi

printf '\nUser installation\n'
shell_link="$config_home/quickshell/astralith"
command_link="$HOME/.local/bin/astralithctl"
if [[ -L "$shell_link" && "$(readlink -f -- "$shell_link")" == "$project_root" ]]; then
    status_line "OK" "$shell_link" "points to this checkout"
elif [[ -e "$shell_link" || -L "$shell_link" ]]; then
    status_line "CHECK" "$shell_link" "exists but points somewhere else"
else
    status_line "OPTION" "$shell_link" "run ./scripts/install-user"
fi

if [[ -L "$command_link" && "$(readlink -f -- "$command_link")" == "$script_dir/astralithctl" ]]; then
    status_line "OK" "$command_link" "control command installed"
elif [[ -e "$command_link" || -L "$command_link" ]]; then
    status_line "CHECK" "$command_link" "exists but points somewhere else"
else
    status_line "OPTION" "$command_link" "run ./scripts/install-user"
fi

printf '\nSummary: %s required integration(s) missing; %s optional available; %s optional missing.\n' \
    "$missing_required" "$available_optional" "$missing_optional"

if (( missing_required > 0 )); then
    printf 'Astralith cannot provide its complete core session on this machine yet.\n' >&2
    exit 1
fi

printf 'Core runtime is ready. Missing optional tools only disable their related features.\n'
