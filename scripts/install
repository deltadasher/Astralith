#!/usr/bin/env sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
manifest="$project_root/installer/Cargo.toml"
binary="$project_root/installer/target/release/astralith-installer"

if [ -x "$binary" ]; then
    newer_source=$(find "$project_root/installer/src" "$manifest" \
        "$project_root/installer/Cargo.lock" -newer "$binary" -print -quit)
    if [ -z "$newer_source" ]; then
        exec "$binary" --source "$project_root" "$@"
    fi
fi

if ! command -v cargo >/dev/null 2>&1; then
    printf '%s\n' 'Astralith installer is not built and Cargo is unavailable.' >&2
    printf '%s\n' 'On Arch Linux, install Rust with: sudo pacman -S rust' >&2
    printf '%s\n' 'A future release artifact will not require Cargo.' >&2
    exit 1
fi

exec cargo run --quiet --release --locked --manifest-path "$manifest" -- \
    --source "$project_root" "$@"
