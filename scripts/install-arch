#!/usr/bin/env bash

set -euo pipefail

profile="recommended"
dry_run=0
migrate_dms=0
install_niri_config=0

usage() {
    cat <<'EOF'
Usage: ./scripts/install-arch [OPTIONS]

Install Astralith dependencies on Arch Linux and derivatives, then create the
reversible user-local links. Packages are never removed.

Options:
  --minimal              Install only the core runtime and validation tools
  --recommended          Install the normal desktop feature set (default)
  --full                 Install every packaged integration
  --migrate-dms          Mask and stop the DMS user service after confirmation
  --install-niri-config  Validate, back up, and install Astralith's Niri config
  --dry-run              Print actions without changing the machine
  -h, --help             Show this help
EOF
}

while (($#)); do
    case "$1" in
        --minimal) profile="minimal" ;;
        --recommended) profile="recommended" ;;
        --full) profile="full" ;;
        --migrate-dms) migrate_dms=1 ;;
        --install-niri-config) install_niri_config=1 ;;
        --dry-run) dry_run=1 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

if [[ ! -r /etc/os-release ]]; then
    printf 'Cannot identify this distribution: /etc/os-release is unavailable.\n' >&2
    exit 1
fi

# shellcheck disable=SC1091
. /etc/os-release
if [[ "${ID:-}" != "arch" && " ${ID_LIKE:-} " != *" arch "* ]]; then
    printf 'This installer supports Arch Linux derivatives only (detected: %s).\n' "${ID:-unknown}" >&2
    exit 1
fi

if ! command -v pacman >/dev/null 2>&1; then
    printf 'pacman is required by the Arch installer.\n' >&2
    exit 1
fi

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"

core_packages=(
    bash git niri quickshell python wireplumber pipewire-pulse
    qt6-declarative
)
recommended_packages=(
    networkmanager bluez-utils wl-clipboard cliphist
    grim slurp satty brightnessctl power-profiles-daemon
    awww matugen ffmpeg cava playerctl polkit-gnome
    ttf-jetbrains-mono-nerd ttf-iosevka-nerd
)
full_packages=(
    gpu-screen-recorder easyeffects
)

packages=("${core_packages[@]}")
if [[ "$profile" == "recommended" || "$profile" == "full" ]]; then
    packages+=("${recommended_packages[@]}")
fi
if [[ "$profile" == "full" ]]; then
    packages+=("${full_packages[@]}")
fi

# Do not explicitly target already-installed packages. CachyOS packages can
# carry a newer distro revision than the current Arch sync database; targeting
# those packages would make pacman propose an unnecessary downgrade.
missing_packages=()
for package in "${packages[@]}"; do
    if ! pacman -Qq "$package" >/dev/null 2>&1; then
        missing_packages+=("$package")
    fi
done

run() {
    printf '  +'
    printf ' %q' "$@"
    printf '\n'
    if (( ! dry_run )); then
        "$@"
    fi
}

printf 'Astralith Arch installer\n'
printf 'Profile: %s\n\n' "$profile"

# Arch and its derivatives do not support partial upgrades. Refresh package
# databases and upgrade the system in the same transaction so repository
# rebuild suffixes (for example CachyOS -1.1 packages) remain consistent.
if ((${#missing_packages[@]})); then
    run sudo pacman -Syu --needed "${missing_packages[@]}"
else
    printf 'All packages for the %s profile are already installed.\n' "$profile"
fi

# Arch keeps Qt developer tools in /usr/lib/qt6/bin. Expose qmllint through the
# existing user-local command directory without modifying a shell profile.
if [[ ! -x "$HOME/.local/bin/qmllint" ]]; then
    if (( dry_run )); then
        printf '  + mkdir -p %q\n' "$HOME/.local/bin"
        printf '  + ln -s %q %q\n' /usr/lib/qt6/bin/qmllint "$HOME/.local/bin/qmllint"
    else
        mkdir -p -- "$HOME/.local/bin"
        ln -s -- /usr/lib/qt6/bin/qmllint "$HOME/.local/bin/qmllint"
    fi
fi

run "$script_dir/doctor"
run "$script_dir/install-user"
run env "PATH=$HOME/.local/bin:/usr/lib/qt6/bin:$PATH" "$script_dir/check"

if (( migrate_dms )); then
    printf '\nDMS migration requested. Astralith does not uninstall DMS or delete its data.\n'
    if (( dry_run )); then
        printf '  + systemctl --user mask --now dms.service\n'
        printf '  + dms kill\n'
    else
        read -r -p 'Mask and stop the DMS user service now? [y/N] ' answer
        if [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]]; then
            systemctl --user mask --now dms.service
            if command -v dms >/dev/null 2>&1; then
                dms kill || true
            fi
        else
            printf 'DMS was preserved and left running.\n'
        fi
    fi
fi

if (( install_niri_config )); then
    run "$script_dir/sync-compositor-configs" --niri
else
    run "$script_dir/sync-compositor-configs" --check
fi

printf '\nInstallation complete. Test in the foreground before enabling autostart:\n'
printf '  astralithctl run\n'
printf '\nOptional integrations not installed automatically: mpvpaper.\n'
