#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_parent="$config_home/quickshell"
config_target="$config_parent/astralith"
bin_parent="$HOME/.local/bin"
control_target="$bin_parent/astralithctl"

ensure_link_target() {
    local target="$1"
    local expected="$2"
    if [[ -L "$target" && "$(readlink -f -- "$target")" == "$expected" ]]; then
        return
    fi
    if [[ -e "$target" || -L "$target" ]]; then
        printf 'Refusing to replace existing path: %s\n' "$target" >&2
        exit 1
    fi
    ln -s -- "$expected" "$target"
    printf 'Linked: %s -> %s\n' "$target" "$expected"
}

mkdir -p -- "$config_parent" "$bin_parent"
ensure_link_target "$config_target" "$project_root"
ensure_link_target "$control_target" "$script_dir/astralithctl"

printf '\nAstralith user links are installed.\n'
printf 'Ensure %s is in PATH, then run: astralithctl start\n' "$bin_parent"
printf 'The Niri example config now uses astralithctl and contains no user-specific paths.\n'
