#!/usr/bin/env bash

set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
state_dir="${state_home}/astralith"
pid_file="${state_dir}/recording.pid"
recording_file="${state_dir}/recording.output"
picture_dir="${HOME}/Pictures/Screenshots"
video_dir="${HOME}/Videos/Astralith Captures"

notify_user() {
    local summary="$1"
    local body="$2"
    if [[ -x "${script_dir}/astralith-notify" ]]; then
        "${script_dir}/astralith-notify" "$summary" "$body" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Astralith Optics" "$summary" "$body"
    fi
}

fail_missing() {
    local missing=()
    for dependency in "$@"; do
        command -v "$dependency" >/dev/null 2>&1 || missing+=("$dependency")
    done
    if (( ${#missing[@]} > 0 )); then
        notify_user "Optics unavailable" "Missing: ${missing[*]}"
        exit 1
    fi
}

recording_pid() {
    [[ -f "$pid_file" ]] || return 1
    local pid
    pid="$(<"$pid_file")"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

recording_status() {
    if recording_pid >/dev/null; then
        printf 'recording\n'
    else
        rm -f -- "$pid_file"
        printf 'idle\n'
    fi
}

select_geometry() {
    slurp \
        -d \
        -b '#080910a8' \
        -c '#a99cffff' \
        -s '#a99cff2e' \
        -B '#10121df2' \
        -F 'JetBrains Mono' \
        -w 3
}

capture_image() {
    local scope="$1"
    local action="$2"
    fail_missing grim
    [[ "$scope" == "region" ]] && fail_missing slurp
    [[ "$action" == "copy" ]] && fail_missing wl-copy
    [[ "$action" == "edit" ]] && fail_missing satty wl-copy

    local geometry=""
    if [[ "$scope" == "region" ]]; then
        geometry="$(select_geometry)" || exit 0
        [[ -n "$geometry" ]] || exit 0
    fi

    mkdir -p -- "$picture_dir"
    local output="${picture_dir}/Screenshot_$(date +%Y-%m-%d-%H%M%S).png"

    if [[ "$action" == "copy" ]]; then
        if [[ -n "$geometry" ]]; then
            grim -g "$geometry" - | wl-copy --type image/png
        else
            grim - | wl-copy --type image/png
        fi
        notify_user "Snip copied" "Image is ready on the clipboard"
        return
    fi

    if [[ "$action" == "edit" ]]; then
        local temporary
        temporary="$(mktemp --suffix=.png)"
        trap 'rm -f -- "$temporary"' EXIT
        if [[ -n "$geometry" ]]; then
            grim -g "$geometry" "$temporary"
        else
            grim "$temporary"
        fi
        satty --filename "$temporary" --output-filename "$output" \
            --copy-command wl-copy
        return
    fi

    if [[ -n "$geometry" ]]; then
        grim -g "$geometry" "$output"
    else
        grim "$output"
    fi
    notify_user "Capture archived" "$output"
}

start_recording() {
    fail_missing gpu-screen-recorder
    if recording_pid >/dev/null; then
        notify_user "Recording already active" "Stop the current capture before starting another"
        exit 0
    fi

    mkdir -p -- "$state_dir" "$video_dir"
    local output="${video_dir}/Astralith_$(date +%Y-%m-%d-%H%M%S).mp4"
    local log_file="${state_dir}/recording.log"

    nohup gpu-screen-recorder \
        -w portal \
        -f 60 \
        -q very_high \
        -k h264 \
        -a default_output \
        -cursor yes \
        -o "$output" >"$log_file" 2>&1 &
    local pid=$!
    printf '%s\n' "$pid" >"$pid_file"
    printf '%s\n' "$output" >"$recording_file"
    notify_user "Capture stream armed" "Choose a portal target; 60 FPS desktop audio is enabled"
}

stop_recording() {
    local pid
    if ! pid="$(recording_pid)"; then
        rm -f -- "$pid_file"
        notify_user "No active recording" "Capture stream is already idle"
        exit 0
    fi

    kill -INT "$pid"
    local output=""
    [[ -f "$recording_file" ]] && output="$(<"$recording_file")"
    notify_user "Finalizing capture" "${output:-Recording is being written to disk}"
}

mode="${1:---region-copy}"
case "$mode" in
    --region-copy) capture_image region copy ;;
    --region-save) capture_image region save ;;
    --region-edit) capture_image region edit ;;
    --full|--full-copy) capture_image full copy ;;
    --full-save) capture_image full save ;;
    --full-edit) capture_image full edit ;;
    --record-start) start_recording ;;
    --record-stop) stop_recording ;;
    --record-status) recording_status ;;
    --open-captures)
        mkdir -p -- "$picture_dir"
        xdg-open "$picture_dir"
        ;;
    --open-recordings)
        mkdir -p -- "$video_dir"
        xdg-open "$video_dir"
        ;;
    *)
        printf 'usage: %s [--region-copy|--region-save|--region-edit|--full-copy|--full-save|--full-edit|--record-start|--record-stop|--record-status]\n' "$0" >&2
        exit 2
        ;;
esac
