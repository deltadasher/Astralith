#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
astralith_root="$(cd -- "$script_dir/.." && pwd)"
mode="${1:---check}"

niri_source="$astralith_root/niri/config.kdl"
niri_target="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"

validate() {
    niri validate -c "$niri_source"
}

install_config() {
    local source="$1"
    local target="$2"
    local stamp="$3"

    mkdir -p "$(dirname -- "$target")"
    if [[ -e "$target" ]]; then
        cp -a -- "$target" "$target.astralith-backup-$stamp"
        printf 'Backup: %s\n' "$target.astralith-backup-$stamp"
    fi
    install -m 0644 -- "$source" "$target"
    printf 'Installed: %s\n' "$target"
}

validate

if [[ "$mode" == "--check" ]]; then
    printf 'Niri config validates. Nothing was installed.\n'
    exit 0
fi

stamp="$(date +%Y%m%d-%H%M%S)"
case "$mode" in
    --niri)
        install_config "$niri_source" "$niri_target" "$stamp"
        ;;
    *)
        printf 'Usage: %s [--check|--niri]\n' "$0" >&2
        exit 2
        ;;
esac

printf 'Done. Niri hot-reloads its active config.\n'
