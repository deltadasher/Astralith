#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
theme="astralith-umbra"; action="${1:-help}"; target="${2:-auto}"
usage(){ cat <<'EOF'
Usage: umbra-greeter-portable {status|install|activate|deactivate|preview} [auto|sddm|lightdm|greetd|ly|gdm]
SDDM and LightDM receive graphical Umbra themes. greetd/tuigreet and Ly receive
terminal-native Umbra adapters. GDM is detected but never patched: it has no
stable custom greeter-theme API.
EOF
}
detect(){ if systemctl is-active --quiet sddm.service 2>/dev/null || command -v sddm-greeter >/dev/null 2>&1; then echo sddm; elif systemctl is-active --quiet lightdm.service 2>/dev/null || command -v lightdm >/dev/null 2>&1; then echo lightdm; elif systemctl is-active --quiet greetd.service 2>/dev/null || command -v greetd >/dev/null 2>&1; then echo greetd; elif systemctl is-active --quiet ly.service 2>/dev/null || command -v ly >/dev/null 2>&1; then echo ly; elif systemctl is-active --quiet gdm.service 2>/dev/null || command -v gdm >/dev/null 2>&1; then echo gdm; else echo unknown; fi; }
resolve(){ if [[ "$target" == auto ]]; then target="$(detect)"; fi; }
supported(){ resolve; case "$target" in sddm|lightdm|greetd|ly) ;; gdm) echo 'GDM has no supported custom greeter-theme API.' >&2; exit 3;; *) echo 'No supported display manager detected; specify a target.' >&2; exit 3;; esac; }
install_target(){ supported; case "$target" in sddm) exec "$root/scripts/umbra-greeter" install;; lightdm) sudo install -d "/usr/share/web-greeter/themes/$theme"; sudo cp -a "$root/modules/umbra/greeter/lightdm/." "/usr/share/web-greeter/themes/$theme/";; greetd) sudo install -Dm0644 "$root/modules/umbra/greeter/tuigreet/$theme.toml" "/etc/tuigreet/$theme.toml";; ly) sudo install -Dm0644 "$root/modules/umbra/greeter/ly/$theme.conf" "/etc/ly/conf.d/30-$theme.conf";; esac; }
case "$action" in
 status) resolve; echo "detected=$target"; case "$target" in sddm) if [[ -f "/usr/share/sddm/themes/$theme/Main.qml" ]]; then echo installed=yes; else echo installed=no; fi;; lightdm) if [[ -f "/usr/share/web-greeter/themes/$theme/index.html" ]]; then echo installed=yes; else echo installed=no; fi;; greetd) if [[ -f "/etc/tuigreet/$theme.toml" ]]; then echo installed=yes; else echo installed=no; fi;; ly) if [[ -f "/etc/ly/conf.d/30-$theme.conf" ]]; then echo installed=yes; else echo installed=no; fi;; gdm) echo installed=unsupported;; *) echo installed=unknown;; esac;;
 install) install_target; echo "Installed Umbra adapter for $target.";;
 activate) install_target; case "$target" in sddm) exec "$root/scripts/umbra-greeter" activate;; lightdm) command -v web-greeter >/dev/null || { echo 'Install web-greeter first.' >&2; exit 3; }; sudo install -Dm0644 /dev/stdin /etc/lightdm/lightdm.conf.d/30-astralith-umbra.conf <<'EOF'
[Seat:*]
greeter-session=web-greeter
EOF
 echo 'Set theme: astralith-umbra in /etc/lightdm/web-greeter.yml (or web-greeter.toml).';; greetd) echo 'Installed /etc/tuigreet/astralith-umbra.toml. Add --config /etc/tuigreet/astralith-umbra.toml to your existing tuigreet command; Astralith will not guess the session command.';; ly) echo 'Installed Ly fragment; include it from Ly’s active config to avoid overwriting /etc/ly/config.ini.';; esac;;
 deactivate) supported; case "$target" in sddm) exec "$root/scripts/umbra-greeter" deactivate;; lightdm) sudo rm -f /etc/lightdm/lightdm.conf.d/30-astralith-umbra.conf;; *) echo "No activation override was written for $target.";; esac;;
 preview) resolve; [[ "$target" == sddm ]] || { echo 'Only SDDM supports a graphical test-mode preview.' >&2; exit 3; }; exec "$root/scripts/umbra-greeter" preview;;
 help|-h|--help) usage;; *) usage >&2; exit 2;; esac
