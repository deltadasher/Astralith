#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
shell_link="$config_home/quickshell/astralith"
command_link="$HOME/.local/bin/astralithctl"

remove_owned_link() {
    local target="$1"
    local expected="$2"
    if [[ -L "$target" && "$(readlink -f -- "$target")" == "$expected" ]]; then
        unlink -- "$target"
        printf 'Removed link: %s\n' "$target"
    elif [[ -e "$target" || -L "$target" ]]; then
        printf 'Preserved unrelated path: %s\n' "$target"
    else
        printf 'Already absent: %s\n' "$target"
    fi
}

remove_owned_link "$command_link" "$script_dir/astralithctl"
remove_owned_link "$shell_link" "$project_root"

printf '\nAstralith user links are removed.\n'
printf 'Settings and caches were preserved under your XDG config/cache directories.\n'
