#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"

cd -- "$project_root"

if [[ ! -d .git ]]; then
    printf 'Astralith is not a Git checkout: %s\n' "$project_root" >&2
    exit 2
fi

if [[ -n "$(git status --porcelain)" ]]; then
    printf 'Refusing to update a checkout with local changes.\n' >&2
    printf 'Commit, stash, or discard them first:\n' >&2
    git status --short >&2
    exit 1
fi

printf 'Updating Astralith with a fast-forward-only pull...\n'
git pull --ff-only

printf '\nValidating the updated checkout...\n'
"$script_dir/check"

if qs -p "$project_root" list 2>/dev/null | grep -q '^Instance '; then
    printf '\nRestarting the active Astralith shell...\n'
    "$script_dir/astralithctl" restart
else
    printf '\nUpdate complete. Astralith was not running; start it with astralithctl start.\n'
fi
