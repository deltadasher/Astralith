#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
runtime_root="$(cd -- "$script_dir/.." && pwd)"

receipt="$runtime_root/.astralith-install"
if [[ -d "$runtime_root/.git" ]]; then
    source_root="$runtime_root"
    profile="recommended"
    niri_mode="keep"
    umbra_mode="lock"
elif [[ -f "$receipt/source" ]]; then
    source_root="$(<"$receipt/source")"
    profile="$(<"$receipt/profile")"
    niri_mode="$(<"$receipt/niri")"
    umbra_mode="$(<"$receipt/umbra")"
else
    printf 'This Astralith runtime predates installed-update metadata.\n' >&2
    printf 'Reapply it once from the source checkout, then update will work normally:\n' >&2
    printf '  ./scripts/install apply --profile recommended\n' >&2
    exit 2
fi

if [[ "$source_root" != /* || ! -d "$source_root/.git" ]]; then
    printf 'Astralith source is not a Git checkout: %s\n' "$source_root" >&2
    exit 2
fi

if [[ -n "$(git -C "$source_root" status --porcelain)" ]]; then
    printf 'Refusing to update a checkout with local changes.\n' >&2
    printf 'Commit, stash, or discard them first:\n' >&2
    git -C "$source_root" status --short >&2
    exit 1
fi

was_running=0
if command -v qs >/dev/null 2>&1 \
    && qs -p "$runtime_root" list 2>/dev/null | grep -q '^Instance '; then
    was_running=1
fi

printf 'Updating Astralith with a fast-forward-only pull...\n'
git -C "$source_root" pull --ff-only

printf '\nApplying the updated runtime transaction...\n'
if [[ -x "$source_root/scripts/install" ]]; then
    installer=("$source_root/scripts/install")
elif [[ -x "$runtime_root/bin/astralith-installer" ]]; then
    installer=("$runtime_root/bin/astralith-installer" --source "$source_root")
else
    printf 'No Astralith installer executor is available.\n' >&2
    exit 2
fi
"${installer[@]}" apply \
    --profile "$profile" \
    --niri "$niri_mode" \
    --umbra "$umbra_mode" \
    --yes

if (( was_running )); then
    printf '\nRestarting the active Astralith shell...\n'
    "$runtime_root/scripts/astralithctl" restart
else
    printf '\nUpdate complete. Astralith was not running; start it with astralithctl start.\n'
fi
